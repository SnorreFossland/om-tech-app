# Local development environment variables
# Copy this to `.env` (do NOT commit `.env`) and adjust as needed.

# Example using a local SQLite file-based database for development
DATABASE_URL="file:./dev.db"

# Test database used by CI and local debug scripts
TEST_DATABASE_URL="file:./test-dev.db"

# If you use PostgreSQL locally, use a connection string like:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth / runtime secrets
# Generate a secure random string for AUTH_SECRET (32+ bytes). Do NOT commit your real secret.
AUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: other runtime envs you might need
# NEXT_PUBLIC_APP_NAME="My App"

# Instructions:
# 1. Copy this file to .env and replace placeholders with real values for local development.
# 2. Never commit real secrets. Use GitHub Actions repository secrets for CI.
